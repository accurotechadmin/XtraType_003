{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.portashape.invalid/companion/0.1/publication.schema.json",
  "title": "Publish.Publication v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "recordType": {
      "const": "Publish.Publication"
    },
    "schemaVersion": {
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "ownerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "objectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "authorRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "title": {
      "type": "string",
      "maxLength": 80000
    },
    "body": {
      "type": "string",
      "maxLength": 80000
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "id",
          "hash",
          "size",
          "mediaType"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 50
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 50
    },
    "location": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "label": {
          "type": "string",
          "maxLength": 80000
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "additionalProperties": false
    },
    "price": {
      "type": "object",
      "properties": {
        "minorAmount": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "minorAmount",
        "currency"
      ],
      "additionalProperties": false
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "destinationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 20
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "id",
    "recordType",
    "schemaVersion",
    "createdAt",
    "updatedAt",
    "ownerId",
    "objectId",
    "authorRef",
    "body",
    "attachments",
    "links",
    "tags",
    "destinationIds",
    "revision"
  ],
  "additionalProperties": false
}