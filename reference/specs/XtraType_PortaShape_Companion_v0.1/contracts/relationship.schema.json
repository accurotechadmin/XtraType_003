{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.portashape.invalid/companion/0.1/relationship.schema.json",
  "title": "Context.Relationship v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "recordType": {
      "const": "Context.Relationship"
    },
    "schemaVersion": {
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "ownerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "fromRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "relationType": {
      "enum": [
        "related-to",
        "corrects",
        "warns-about",
        "alternative-to",
        "references",
        "supersedes"
      ]
    },
    "toRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "authorRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "explanation": {
      "type": "string",
      "maxLength": 80000
    }
  },
  "required": [
    "id",
    "recordType",
    "schemaVersion",
    "createdAt",
    "updatedAt",
    "ownerId",
    "fromRef",
    "relationType",
    "toRef",
    "authorRef"
  ],
  "additionalProperties": false
}