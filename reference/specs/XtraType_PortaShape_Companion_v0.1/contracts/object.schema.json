{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.portashape.invalid/companion/0.1/object.schema.json",
  "title": "Core.Object v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "recordType": {
      "const": "Core.Object"
    },
    "schemaVersion": {
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "ownerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "handleRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 100
    },
    "shape": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "payloadRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "provenanceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 100
    }
  },
  "required": [
    "id",
    "recordType",
    "schemaVersion",
    "createdAt",
    "updatedAt",
    "ownerId",
    "type",
    "handleRefs",
    "shape",
    "payloadRef",
    "provenanceRefs"
  ],
  "additionalProperties": false
}