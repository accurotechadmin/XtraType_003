{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.portashape.invalid/companion/0.1/message.schema.json",
  "title": "Context.Message v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "recordType": {
      "const": "Context.Message"
    },
    "schemaVersion": {
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "ownerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "conversationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "body": {
      "type": "string",
      "maxLength": 80000
    },
    "authorRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "parentMessageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "legacyAnnotationRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "id",
    "recordType",
    "schemaVersion",
    "createdAt",
    "updatedAt",
    "ownerId",
    "conversationId",
    "body",
    "authorRef"
  ],
  "additionalProperties": false
}