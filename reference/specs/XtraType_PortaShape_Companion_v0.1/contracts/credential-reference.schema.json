{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.portashape.invalid/companion/0.1/credential-reference.schema.json",
  "title": "Trust.CredentialReference v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "recordType": {
      "const": "Trust.CredentialReference"
    },
    "schemaVersion": {
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "ownerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "opaqueRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "accountLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 100
    },
    "mode": {
      "const": "browser-session"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "recordType",
    "schemaVersion",
    "createdAt",
    "updatedAt",
    "ownerId",
    "providerId",
    "opaqueRef",
    "accountLabel",
    "scopes",
    "mode"
  ],
  "additionalProperties": false
}