{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.portashape.invalid/companion/0.1/invocation.schema.json",
  "title": "Host.Invocation v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "recordType": {
      "const": "Host.Invocation"
    },
    "schemaVersion": {
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "ownerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operationMajor": {
      "type": "integer",
      "minimum": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "providerRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "input": {
      "type": "object"
    },
    "contextRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time"
    },
    "intentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "id",
    "recordType",
    "schemaVersion",
    "createdAt",
    "updatedAt",
    "ownerId",
    "requestId",
    "operationId",
    "operationMajor",
    "providerId",
    "providerRevision",
    "input",
    "deadlineAt",
    "intentId"
  ],
  "additionalProperties": false
}