{
  "manifest_version": 3,
  "name": "XtraType",
  "short_name": "XtraType",
  "version": "2.5.1",
  "description": "Local-first contextual annotations, typed anchors, images, page capture and visual history.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus",
    "tabs",
    "webNavigation",
    "geolocation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Toggle XtraType"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "omnibox": {
    "keyword": "xt"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "windows": "Ctrl+Q",
        "linux": "Ctrl+Q",
        "chromeos": "Ctrl+Q",
        "mac": "MacCtrl+Q"
      }
    }
  }
}
